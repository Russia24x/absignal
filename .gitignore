# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never committed (.env.example is the template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs & local artifacts
local-*
*.log
server.log

# local tooling
.claude
.z-ai-config
test
prompt

# Skills directory (sandbox tooling, not part of the app)
/skills/

# ── secrets & local databases — NEVER commit ──
/db/
*.db
*.db-journal

# ── sandbox infrastructure (not part of the app repo) ──
/.zscripts/
Caddyfile
/download/
/examples/
/mini-services/
/tests/
agent-ctx/tool-results/
tool-results/

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# owner-supplied patch artifacts (applied & archived in git history)
/upload/
