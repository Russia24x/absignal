// PenguSignal — database schema
// SQLite locally; see docs/DEPLOYMENT.md for the Cloudflare (Turso/D1) path.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A wallet-based account. Created on first successful signature sign-in.
model User {
  id               String    @id @default(cuid())
  /// Lowercase EVM address (0x…)
  address          String    @unique
  /// LEGACY (pre-v2 tariff): one-time access fee — no longer gating anything.
  /// Kept for rollback safety; new users simply default to true on first purchase.
  accessGranted    Boolean   @default(false)
  accessGrantedAt  DateTime?
  /// Active subscription end (inclusive); null = never subscribed.
  /// Lifetime plans store the 2099-12-31 sentinel (see lib/config.ts).
  subscriptionUntil DateTime?
  /// Last credited plan id: day | week | month | year | lifetime
  subscriptionPlan  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions         Session[]
  paymentIntents   PaymentIntent[]
  signalUnlocks    SignalUnlock[]
}

/// Single-use sign-in nonces (replay protection for wallet signatures).
model AuthNonce {
  id        String    @id @default(cuid())
  address   String
  nonce     String    @unique
  /// Exact message the wallet must sign (stored verbatim — zero drift).
  message   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([address, expiresAt])
}

/// Server-side sessions. The cookie carries `<id>.<secret>`; we store a hash.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A payment intent: expected PENGU amount, later matched to an on-chain tx.
model PaymentIntent {
  id              String    @id @default(cuid())
  userId          String
  /// Always SUBSCRIPTION in the v2 tariff; legacy rows may hold ACCESS | SIGNAL_DAY
  type            String
  /// Days purchased (null = lifetime plan)
  days            Int?
  /// Expected amount in PENGU wei (string — SQLite-safe)
  amountWei       String
  /// PENDING | PAID | EXPIRED
  status          String    @default("PENDING")
  /// On-chain hash that settled this intent (unique — prevents reuse)
  txHash          String?   @unique
  chainId         Int
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  creditedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
}

/// The locked daily signal (one row per UTC day) — the product itself.
model DailySignal {
  id             String   @id @default(cuid())
  /// UTC date, yyyy-mm-dd
  date           String   @unique
  /// STRONG_BUY | BUY | HOLD | SELL | STRONG_SELL
  verdict        String
  /// Composite score, -100..100
  score          Float
  /// 0..100
  confidence     Float
  /// Full analysis snapshot (JSON string)
  dataJson       String
  /// PENGU price (USD) at computation time
  priceAtSignal  Float
  /// Engine generation that produced this signal ('v1' | 'v2' | …) —
  /// the public track record is versioned so upgrades are visible,
  /// never silently rewriting history.
  engine         String   @default("v1")
  /// True when the entry was reconstructed walk-forward from historical
  /// candles (pre-launch backfill) rather than locked live on the day.
  backfilled     Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([date])
}

/// Durable OHLCV cache (R36): candles fetched from the upstream are persisted
/// so charts, the track record's outcome resolution, and backtests survive
/// upstream outages (GeckoTerminal intermittently rate-limits the shared
/// Cloudflare Workers egress IP). Historical buckets are immutable, so one
/// successful fetch is durable forever. On D1 the table is ALSO auto-created
/// at runtime (CREATE TABLE IF NOT EXISTS — see lib/market/geckoterminal.ts);
/// this model exists so dev/e2e SQLite and the remote D1 stay in lockstep.
model CandleCache {
  /// Natural key "{pool}:{tf}:{time}"
  id        String @id
  pool      String
  tf        String
  /// Bucket start, unix seconds
  time      Int
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  /// Last refresh of this row, unix SECONDS (Int is 32-bit — ms overflows)
  updatedAt Int

  @@index([pool, tf, time])
}

/// LEGACY (pre-v2 tariff): per-user per-day unlocks bought with 1 PENGU.
/// Kept as an audit trail of old day-passes; the new tariff is purely
/// time-based (see lib/config.ts subscriptionPackages).
model SignalUnlock {
  id         String   @id @default(cuid())
  userId     String
  /// UTC date, yyyy-mm-dd
  signalDate String
  intentId   String   @unique
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, signalDate])
  @@index([signalDate])
}
