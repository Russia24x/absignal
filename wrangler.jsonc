{
        "$schema": "node_modules/wrangler/config-schema.json",
        "main": ".open-next/worker.js",
        // Worker name MUST match the Cloudflare Workers Builds project name.
        // The owner renamed the project to the intended product name "pengusignal"
        // in the Cloudflare dashboard (2026-08-29) — live at
        // https://pengusignal.russia24x.workers.dev (R30 temporarily used "absignal").
        "name": "pengusignal",
        "compatibility_date": "2026-08-28",
        "compatibility_flags": [
                "nodejs_compat",
                "global_fetch_strictly_public"
        ],
        "assets": {
                "directory": ".open-next/assets",
                "binding": "ASSETS"
        },
        "d1_databases": [
                {
                        "binding": "DB",
                        "database_name": "pengusignal",
                        "database_id": "aa91256d-98f1-4d81-b294-2a34b0c4ebb3"
                }
        ],
        "services": [
                {
                        // Self-reference service binding, the service name must match the worker name
                        // see https://opennext.js.org/cloudflare/caching
                        // Must equal `name` — a mismatch makes deploys fail with CF API error 10143 (R30/R31)
                        "binding": "WORKER_SELF_REFERENCE",
                        "service": "pengusignal"
                }
        ],
        "images": {
                // Enable image optimization
                // see https://opennext.js.org/cloudflare/howtos/image
                "binding": "IMAGES"
        }
}