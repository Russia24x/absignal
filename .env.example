# ── Database ──────────────────────────────────────────────
# SQLite file (absolute path; relative paths resolve against prisma/schema.prisma)
DATABASE_URL=file:/absolute/path/to/my-project/db/custom.db

# ── Network mode: mainnet | testnet ───────────────────────
NEXT_PUBLIC_APP_NETWORK=mainnet

# ── Abstract chains ───────────────────────────────────────
NEXT_PUBLIC_RPC_MAINNET=https://api.mainnet.abs.xyz
NEXT_PUBLIC_RPC_TESTNET=https://api.testnet.abs.xyz

# ── PENGU token (verified on-chain, 18 decimals) ──────────
NEXT_PUBLIC_PENGU_MAINNET=0x9ebe3a824ca958e4b3da772d2065518f009cba62
# No official PENGU on testnet — set when testing (see docs/TESTNET.md)
NEXT_PUBLIC_PENGU_TESTNET=

# ── Treasury: every PENGU payment lands here ──────────────
NEXT_PUBLIC_TREASURY_ADDRESS=0x60Df4E186364c3a49A550Aee29Da1d5fe3658818

# ── Gas sponsorship (optional, 0 gas for users) ───────────
# Address of YOUR deployed "General" paymaster on Abstract (see
# docs/DEPLOYMENT.md § Gas sponsorship). When set, ALL wallet transactions
# are signed with the sponsor paymaster attached at the provider level
# (official customPaymasterHandler pattern), so users pay ZERO network fee
# — the app sponsors gas. Leave empty to disable (users then pay normal
# gas from their wallet ETH; AGW account deployment is already sponsored
# by Abstract's default paymaster). Payments always use Abstract's
# optimistic submission endpoint for instant feedback.
NEXT_PUBLIC_SPONSOR_PAYMASTER_ADDRESS=

# ── Abstract Portal app listing (optional) ────────────────
# The numeric appId of this app on the Abstract Portal (visible in the
# portal URL after listing). When set, an official "Upvote on Abstract"
# banner (on-chain voting contract 0x3b50de2…ce2a) appears in the footer.
# Leave empty until the app is listed on the portal.
NEXT_PUBLIC_ABSTRACT_APP_ID=

# ── Market data (GeckoTerminal free API) ──────────────────
GECKOTERMINAL_NETWORK=abstract
GECKOTERMINAL_POOL=0xda7d037fda848177141e037f9d0c67cae7b53262
# Optional: route upstream calls through a self-hosted proxy if the shared
# Workers egress IP stays rate-limited (see DEPLOYMENT.md §8)
# GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# ── Market data fallbacks (R38/R39: CEX venues + CoinMarketCap) ──
# R39 ground truth (diagnosed from the deployed Worker itself): Binance's WAF
# blocks the shared Cloudflare Workers egress IPs with 403 on every host
# (data-api.binance.vision, api.binance.com, api1-4, fapi) — so in production
# the CEX tier is carried by the venues that answer 200 from that same egress:
# Bybit → OKX → MEXC → Gate.io (all keyless, all serving real PENGU klines).
# Binance stays last in the chain — it works from other egresses (local dev)
# and may unblock someday. All venues serve REAL OHLCV (engine-grade).
# CEX_VENUES: ordered, comma-separated; empty disables the whole CEX tier
# (the outage-simulation hook for tests).
CEX_VENUES=bybit,okx,mexc,gate,binance
BYBIT_SYMBOL=PENGUUSDT
OKX_SYMBOL=PENGU-USDT
MEXC_SYMBOL=PENGUUSDT
GATE_SYMBOL=PENGU_USDT
BINANCE_SYMBOL=PENGUUSDT
# BINANCE_BASE_URL=https://data-api.binance.vision
# CoinMarketCap is the LAST price-card tier: it arms only when an API key is
# set (free tier ~10k credits/day — see coinmarketcap.com/api). Without a key
# the tier is skipped and nothing else changes. NOTE: set it as an ENCRYPTED
# SECRET in the Cloudflare dashboard (Workers → Settings → Variables) —
# encrypted secrets survive deploys; plain vars get wiped by wrangler deploy.
# COINMARKETCAP_API_KEY=your-cmc-pro-api-key
# COINMARKETCAP_SYMBOL=PENGU
# COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com

# ── Pricing (PENGU units, v2 tariff — Round-17 staircase) ──
# Free tier: register + login (wallet signature) — signals stay locked.
# No session keys: plain ERC-20 transfers, verified on-chain.
# Balance rule: 1 day = 10 PENGU baseline; longer plans get a tiered
# discount off the linear base, hard-capped at 30% (lifetime = 3y basis).
SUBSCRIPTION_1D_PRICE_PENGU=10           # day plan (1 day, 0% off)
SUBSCRIPTION_7D_PRICE_PENGU=65           # week plan (7 days, ~7% off base 70)
SUBSCRIPTION_30D_PRICE_PENGU=255         # month plan (30 days, 15% off base 300)
SUBSCRIPTION_365D_PRICE_PENGU=2750       # year plan (365 days, ~25% off base 3650)
SUBSCRIPTION_LIFETIME_PRICE_PENGU=7650   # lifetime plan (30% off 3-year base 10950)

# ── Security ──────────────────────────────────────────────
# REQUIRED, ≥ 32 chars — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-min-32-chars-long-random-hex
